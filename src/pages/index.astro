---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Portfolio from '../components/Portfolio.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { getFeaturedProjects } from '../data/projects';
import { generalFaqs } from '../data/faqs';
import { buildBusinessSchema } from '../lib/schema';
---

<MainLayout
  title="Desarrollo web freelance en Argentina | Polinacodes"
  description="Desarrollo web freelance en Argentina: páginas web, tiendas online, landing pages y sistemas a medida. Sitios rápidos y con SEO. Trabajo remoto con clientes de Argentina, Latinoamérica y España. Pedí tu presupuesto."
  ogTitle="Desarrollo web y tiendas online que venden | Polinacodes"
  ogDescription="Páginas web, tiendas online y sistemas a medida rápidos y pensados para vender. Trabajás directo con quien lo desarrolla."
  schema={buildBusinessSchema()}
>
  <Hero />
  <Services />
  <Portfolio projects={getFeaturedProjects()} />
  <Process />
  <Faq items={generalFaqs} />
  <Contact />
</MainLayout>
