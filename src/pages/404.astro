---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Página no encontrada | Polinacodes"
  description="La página que buscás no existe o cambió de lugar."
  noindex
>
  <section class="nf">
    <div class="container">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>No encontré esa página</h1>
      <p class="nf-text">
        Puede que el enlace esté mal escrito o que la página haya cambiado de lugar. Mientras tanto, podés
        volver al inicio o ver los servicios.
      </p>
      <div class="nf-actions">
        <a class="btn" href="/">Volver al inicio <ArrowRight size={16} aria-hidden="true" /></a>
        <a class="btn btn-ghost" href="/servicios/">Ver servicios</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .nf {
    min-height: 82vh;
    display: grid;
    align-items: center;
    padding: 140px 0 80px;
    text-align: center;
  }

  .nf-code {
    font-size: clamp(96px, 20vw, 220px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--accent-brand);
    margin: 0 0 16px;
  }

  .nf h1 {
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.04em;
    margin: 0 0 16px;
  }

  .nf-text {
    max-width: 520px;
    margin: 0 auto 32px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  @media (max-width: 420px) {
    .nf-actions {
      display: grid;
    }
  }
</style>
