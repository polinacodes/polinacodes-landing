---
import Gauge from "@lucide/astro/icons/gauge";
import Smartphone from "@lucide/astro/icons/smartphone";
import SearchCheck from "@lucide/astro/icons/search-check";
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">DISEÑO WEB · TIENDAS ONLINE · SISTEMAS A MEDIDA</p>
      <h1>
        Desarrollo web freelance en Argentina: páginas y tiendas online que
        venden
      </h1>
      <p class="hero-lead">
        Soy desarrolladora web freelance. Diseño y programo páginas web, tiendas
        online (Tiendanube, Shopify, WooCommerce), landing pages y sistemas a
        medida. Trabajás directo conmigo, con tiempos claros y un sitio que
        carga rápido.
      </p>
      <div class="hero-actions">
        <a class="btn" href="#contacto">Pedir presupuesto</a>
        <a class="btn btn-ghost" href="#portfolio">Ver trabajos</a>
      </div>
      <div class="metrics" aria-label="Métricas destacadas">
        <span><Gauge size={14} /> PageSpeed 100/100</span>
        <span><Smartphone size={14} /> 100% adaptable</span>
        <span><SearchCheck size={14} /> SEO &amp; GEO técnico</span>
      </div>
    </div>

    <div class="hero-card" aria-label="Resumen de enfoque">
      <div class="hero-card-top">
        <span class="dot"></span><span>Performance first</span>
      </div>
      <div class="speed-score">100<small>/100</small></div>
      <p>
        Sitios livianos que cargan rápido y no hacen esperar a tus clientes.
      </p>
      <div class="mini-bars" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 160px 0 90px;
    min-height: 720px;
    display: grid;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.7fr);
    gap: 70px;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(40px, 5vw, 70px);
    line-height: 1.03;
    letter-spacing: -0.055em;
    max-width: 800px;
    margin: 0 0 24px;
  }

  .hero-lead {
    font-size: 18px;
    line-height: 1.75;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 0 32px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .metrics span {
    font-size: 11px;
    font-weight: 700;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 9px 12px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  

  .hero-card {
    background: var(--text-primary);
    color: #fff;
    border-radius: 28px;
    padding: 34px;
    min-height: 370px;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .hero-card::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: var(--accent-brand);
    opacity: 0.15;
    right: -90px;
    bottom: -80px;
  }
  .hero-card p {
    color: #ccc;
    max-width: 250px;
  }

  .hero-card-top {
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-brand);
  }

  .speed-score {
    font-size: 92px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
  }
  .speed-score small {
    font-size: 22px;
    letter-spacing: 0;
    color: #aaa;
  }

  .mini-bars {
    display: flex;
    gap: 7px;
    align-items: end;
    height: 48px;
  }
  .mini-bars i {
    width: 25%;
    border-radius: 5px 5px 0 0;
    background: #fff;
    opacity: 0.85;
  }
  .mini-bars i:nth-child(1) {
    height: 45%;
  }
  .mini-bars i:nth-child(2) {
    height: 70%;
  }
  .mini-bars i:nth-child(3) {
    height: 85%;
  }
  .mini-bars i:nth-child(4) {
    height: 100%;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      gap: 45px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 135px 0 70px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-card {
      min-height: 280px;
    }
    .hero h1 {
      font-size: clamp(38px, 9vw, 58px);
    }
  }

  @media (max-width: 420px) {
    .hero {
      padding-top: 125px;
    }
    .hero-actions {
      display: grid;
      grid-template-columns: 1fr;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .metrics {
      display: grid;
      grid-template-columns: 1fr;
    }
    .speed-score {
      font-size: 76px;
    }
  }
</style>
