---
import ServiceCard from './ServiceCard.astro';
import { services } from '../data/services';
---

<section class="section" id="servicios">
  <div class="container">
    <div class="section-intro narrow">
      <p class="eyebrow">SERVICIOS DE DESARROLLO WEB</p>
      <h2 class="section-title">¿Tu página web es lenta o no genera las ventas que esperás?</h2>
      <p class="section-lead">
        Si tu página web carga lento, falla a la hora de pagar o nadie te atiende cuando lo necesitás, tiene arreglo. Creo páginas web, tiendas online y sistemas rápidos, simples de mantener y pensados para acompañar el crecimiento de tu negocio.
      </p>
    </div>

    <div class="service-grid">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </div>
</section>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .service-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 768px) {
    .service-grid { grid-template-columns: 1fr; }
  }
</style>
