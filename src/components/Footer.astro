---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="brand" href="/">Polina<span>.</span>codes</a>
    <div class="footer-links">
      <a href={site.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="#">Aviso legal</a>
    </div>
    <p>© {year} {site.name}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #111;
    color: #aaa;
    border-top: 1px solid #292929;
    padding: 30px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    font-size: 10px;
  }
  .footer-inner .brand { color: #fff; }

  .footer-links { display: flex; gap: 20px; }
  .footer-links a:hover { color: #fff; }

  @media (max-width: 768px) {
    .footer-inner { flex-wrap: wrap; }
    .footer-inner > p { width: 100%; order: 3; margin: 0; }
  }

  @media (max-width: 420px) {
    .footer-links { gap: 12px; }
  }
</style>
