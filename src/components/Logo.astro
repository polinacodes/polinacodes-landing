---
import { Image } from "astro:assets";
import { site } from "../config/site";
import catMark from "../assets/logo/cat.png";

interface Props {
  size?: number;
}

const { size = 36 } = Astro.props;
---

<a class="brand" href="/" aria-label={`${site.name}, inicio`}>
  <Image
    class="brand-mark"
    src={catMark}
    alt=""
    width={size}
    height={size}
    densities={[2, 3]}
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <span class="brand-text">polina<span class="dot">.</span>codes</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  /* .brand-mark {
    display: block;
    flex-shrink: 0;
    border-radius: 50%;
  } */

  .brand :global(.brand-mark) {
    display: block;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }
  .brand-text {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1;
  }
  .dot {
    color: var(--accent-brand);
  }
</style>
