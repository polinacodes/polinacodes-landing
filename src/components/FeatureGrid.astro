---
import Check from "@lucide/astro/icons/check";
import Palette from "@lucide/astro/icons/palette";
import Package from "@lucide/astro/icons/package";
import CreditCard from "@lucide/astro/icons/credit-card";
import Truck from "@lucide/astro/icons/truck";
import Gauge from "@lucide/astro/icons/gauge";
import Mail from '@lucide/astro/icons/mail';
import Search from '@lucide/astro/icons/search';
import Smartphone from '@lucide/astro/icons/smartphone';
import Pencil from '@lucide/astro/icons/pencil';
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import type { FeatureIcon } from "../data/servicePages";

interface Item {
  title: string;
  text: string;
  icon?: FeatureIcon;
}

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  items: Item[];
  /** 'icon' = tarjetas oscuras con icono rosa; 'number' = tarjetas claras con círculo numerado */
  variant?: "icon" | "number";
  note?: string;
  tone?: "default" | "white";
  id?: string;
}

const {
  eyebrow,
  title,
  intro,
  items,
  variant = "icon",
  note,
  tone = "default",
  id,
} = Astro.props;

// Para sumar un icono: importalo arriba, agregalo acá y en el tipo FeatureIcon (servicePages.ts)
const icons: Record<FeatureIcon | "check", typeof Check> = {
  check: Check,
  palette: Palette,
  package: Package,
  "credit-card": CreditCard,
  truck: Truck,
  gauge: Gauge,
  "graduation-cap": GraduationCap,
  mail: Mail,
  search: Search,
  smartphone: Smartphone,
  pencil: Pencil
};
---

<section
  class:list={[
    "feature-section",
    "section",
    `is-${variant}`,
    { "is-white": tone === "white" },
  ]}
  id={id}
>
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      {intro && <p class="section-lead">{intro}</p>}
    </div>

    <div class="feature-grid">
      {
        items.map((item, i) => {
          const Icon = icons[item.icon ?? "check"];
          return (
            <article class="feature-card">
              <div class={`marker marker-${variant}`} aria-hidden="true">
                {variant === "icon" ? (
                  <Icon size={30} stroke-width={2} />
                ) : (
                  String(i + 1)
                )}
              </div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          );
        })
      }
    </div>

    {note && <p class="feature-note">{note}</p>}
  </div>
</section>

<style>
  .feature-section.is-white {
    background: #fff;
  }

  .feature-section .section-intro {
    margin-bottom: 48px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px;
  }
  .is-white .feature-card {
    background: var(--bg-primary);
  }

  .marker {
    display: grid;
    place-items: center;
    margin-bottom: 18px;
  }

  /* Variante oscura con icono */
  .is-icon .feature-card {
    background:
      radial-gradient(
        circle 220px at 100% 0%,
        rgba(227, 120, 211, 0.28),
        transparent
      ),
      var(--text-primary);
    border-color: #2a2a2e;
    padding: 28px;
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s ease;
  }
  .is-icon .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }
  .marker-icon {
    justify-items: start;
    color: #fff;
    margin-bottom: 16px;
  }
  .is-icon .feature-card h3 {
    color: #fff;
  }
  .is-icon .feature-card p {
    color: rgba(255, 255, 255, 0.8);
  }

  /* Variante clara con número */
  .marker-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-brand);
    color: #111;
    font-size: 14px;
    font-weight: 800;
  }

  .feature-card h3 {
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .feature-card p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
  }

  .feature-note {
    font-size: 13px;
    line-height: 1.6;
    color: #666;
    max-width: 760px;
    margin: 28px 0 0;
  }

  @media (max-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
