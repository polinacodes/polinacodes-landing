---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Check from '@lucide/astro/icons/check';

interface Props {
  name: string;
  h1: string;
  subtitle: string;
  badges: string[];
  ctaLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { name, h1, subtitle, badges, ctaLabel, image, imageAlt = '' } = Astro.props;
---

<section class="svc-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Ruta de navegación">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/servicios/">Servicios</a></li>
        <li aria-current="page">{name}</li>
      </ol>
    </nav>

    <div class:list={['svc-grid', { 'has-media': image }]}>
      <div class="svc-copy">
        <h1>{h1}</h1>
        <p class="svc-lead">{subtitle}</p>

        <div class="svc-actions">
          <a class="btn" href="#contacto">
            {ctaLabel} <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>

        <ul class="svc-badges">
          {
            badges.map((badge) => (
              <li>
                <Check size={14} stroke-width={2.5} aria-hidden="true" /> {badge}
              </li>
            ))
          }
        </ul>
      </div>

      {
        image && (
          <div class="svc-media">
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 720, 960, 1200]}
              sizes="(max-width: 768px) calc(100vw - 40px), 600px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .svc-hero {
    padding: 150px 0 80px;
  }

  .breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 28px;
    font-size: 13px;
    color: #666;
  }
  .breadcrumb li + li::before {
    content: "/";
    margin-right: 8px;
    color: #bbb;
  }
  .breadcrumb a:hover {
    color: #B8256A;
  }
  .breadcrumb li[aria-current="page"] {
    color: var(--text-primary);
    font-weight: 600;
  }

  .svc-grid.has-media {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 48px;
    align-items: center;
  }

  .svc-hero h1 {
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.05em;
    max-width: 880px;
    margin: 0 0 22px;
  }
  .has-media h1 {
    font-size: clamp(32px, 3.8vw, 52px);
  }

  .svc-lead {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 0 30px;
  }

  .svc-badges {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .svc-badges li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 9px 14px;
    border-radius: 999px;
  }
  .svc-badges li :global(svg) {
    color: #B8256A;
  }

  /* Mockups de 1920x1440 con fondo transparente: los márgenes negativos
     descuentan el aire de arriba y abajo. La sombra sigue el contorno de la laptop. */
  .svc-media :global(img) {
    width: 100%;
    height: auto;
    display: block;
    margin-block: -10.6% -9.1%;
    filter: drop-shadow(0 26px 34px rgba(17, 17, 17, 0.2));
  }

  @media (max-width: 768px) {
    .svc-hero {
      padding: 130px 0 60px;
    }
    .svc-grid.has-media {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    
  }

  @media (max-width: 420px) {
    .svc-actions .btn {
      width: 100%;
    }
  }
</style>
