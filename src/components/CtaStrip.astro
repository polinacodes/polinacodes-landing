---
import ArrowRight from '@lucide/astro/icons/arrow-right';

interface Props {
  text: string;
  label?: string;
  href?: string;
}

const { text, label = 'Pedir presupuesto', href = '#contacto' } = Astro.props;
---

<section class="cta-section">
  <div class="container">
    <div class="cta-strip">
      <p>{text}</p>
      <a class="btn" href={href}>{label} <ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    margin-block: -48px;
    position: relative;
  }

  .cta-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 30px 36px;
    border-radius: var(--radius);
    background: #e6a1db;
    color: #111;
    box-shadow: 0 20px 44px rgba(227, 120, 211, 0.35);
  }
  .cta-strip p {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  @media (max-width: 768px) {
    .cta-strip {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      padding: 26px 24px;
    }
    .cta-strip p {
      font-size: 19px;
    }
  }
</style>
