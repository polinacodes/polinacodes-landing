---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Target from "@lucide/astro/icons/target";
import Zap from "@lucide/astro/icons/zap";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import MousePointerClick from "@lucide/astro/icons/mouse-pointer-click";
import CalendarCheck from "@lucide/astro/icons/calendar-check";
import Bell from "@lucide/astro/icons/bell";
import Workflow from "@lucide/astro/icons/workflow";
import MessageCircle from "@lucide/astro/icons/message-circle";
import Gauge from '@lucide/astro/icons/gauge';
import Search from '@lucide/astro/icons/search';
import Palette from '@lucide/astro/icons/palette';

import type { SpotlightIcon } from "../data/servicePages";

interface Point {
  title: string;
  text: string;
  icon: SpotlightIcon;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  points: Point[];
  useCasesTitle?: string;
  useCases?: string[];
  ctaLabel: string;
  ctaNote?: string;
  id?: string;
}

const {
  eyebrow,
  title,
  intro,
  points,
  useCasesTitle,
  useCases,
  ctaLabel,
  ctaNote,
  id,
} = Astro.props;

const icons: Record<SpotlightIcon, typeof Target> = {
  target: Target,
  zap: Zap,
  "shield-check": ShieldCheck,
  pointer: MousePointerClick,
  message: MessageCircle,
  bell: Bell,
  workflow: Workflow,
  calendar: CalendarCheck,
  gauge: Gauge,
  search: Search,
  palette: Palette,
};
---

<section class="spotlight section" id={id}>
  <div class="container spot-grid">
    <div class="spot-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="section-title">{title}</h2>
      <p class="spot-intro">{intro}</p>

      {
        useCases && useCases.length > 0 && (
          <div class="spot-uses">
            {useCasesTitle && <p class="spot-uses-title">{useCasesTitle}</p>}
            <ul>
              {useCases.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="spot-actions">
        <a class="btn spot-cta" href="#contacto">
          {ctaLabel}
          <ArrowRight size={16} aria-hidden="true" />
        </a>
        {ctaNote && <p class="spot-note">{ctaNote}</p>}
      </div>
    </div>

    <div class="spot-points">
      {
        points.map((point) => {
          const Icon = icons[point.icon];
          return (
            <article class="spot-card">
              <div class="spot-icon" aria-hidden="true">
                <Icon size={28} stroke-width={2} />
              </div>
              <h3>{point.title}</h3>
              <p>{point.text}</p>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .spotlight {
    background:
      radial-gradient(
        circle 560px at 100% 0%,
        rgba(227, 120, 211, 0.35),
        transparent
      ),
      var(--text-primary);
    color: #fff;
  }

  .spot-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: center;
  }

  .spotlight .eyebrow {
    color: #b9b9c2;
  }

  .spot-intro {
    font-size: 17px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
    margin: 0 0 28px;
    max-width: 560px;
  }

  .spot-uses {
    margin-bottom: 32px;
  }
  .spot-uses-title {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #b9b9c2;
    margin: 0 0 12px;
  }
  .spot-uses ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .spot-uses li {
    font-size: 13px;
    font-weight: 700;
    padding: 9px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }

  .spot-cta {
    background: #fff;
    border-color: #fff;
    color: #111;
  }
  .spot-cta:hover {
    background: #ececf1;
    border-color: #ececf1;
    color: #111;
  }
  .spot-note {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    margin: 14px 0 0;
  }

  .spot-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .spot-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius);
    padding: 26px;
  }
  .spot-icon {
    color: var(--accent-brand);
    margin-bottom: 14px;
    display: flex;
  }
  .spot-card h3 {
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 8px;
  }
  .spot-card p {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .spot-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  @media (max-width: 600px) {
    .spot-points {
      grid-template-columns: 1fr;
    }
    .spot-cta {
      width: 100%;
    }
  }
</style>
