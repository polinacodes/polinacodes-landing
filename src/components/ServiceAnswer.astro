---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Check from "@lucide/astro/icons/check";
import X from "@lucide/astro/icons/x";

interface Props {
  heading: string;
  text: string;
  forYou: string[];
  notForYou: string[];
  /** Texto del botón dentro de la tarjeta oscura */
  ctaLabel?: string;
}

const {
  heading,
  text,
  forYou,
  notForYou,
  ctaLabel = "Pedir presupuesto",
} = Astro.props;
---

<section class="answer section">
  <div class="container">
    <div class="section-intro">
      <p class="eyebrow">EN POCAS PALABRAS</p>
      <h2 class="section-title">{heading}</h2>
    </div>

    <p class="answer-text">{text}</p>

    <div class="fit-grid">
      <div class="fit fit-yes">
        <h3>Es para vos si…</h3>
        <ul>
          {
            forYou.map((item) => (
              <li>
                <span class="icon yes">
                  <Check size={22} stroke-width={3} aria-hidden="true" />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <div class="fit-actions">
          <a class="btn fit-cta" href="#contacto">
            {ctaLabel}
            <ArrowRight size={16} aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="fit fit-no">
        <h3>Quizás no es para vos si…</h3>
        <ul>
          {
            notForYou.map((item) => (
              <li>
                <span class="icon no">
                  <X size={20} stroke-width={3} aria-hidden="true" />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .answer {
    background: #fff;
  }

  .answer .section-intro {
    margin-bottom: 28px;
  }

  .answer-text {
    font-size: 20px;
    line-height: 1.7;
    color: #333;
    max-width: 820px;
    margin: 0 0 52px;
    padding-left: 22px;
    border-left: 3px solid var(--accent-brand);
  }

  .fit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .fit {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    padding: 36px;
  }

  .fit h3 {
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
    padding-bottom: 22px;
  }

  .fit ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fit li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 17px;
    line-height: 1.55;
    padding: 18px 0;
  }
  .fit li:last-child {
    padding-bottom: 0;
  }

  .icon {
    flex-shrink: 0;
    display: flex;
    margin-top: 2px;
  }

  /* ---------- Tarjeta oscura: "Es para vos si…" ---------- */
  .fit-yes {
    background:
      radial-gradient(
        circle 320px at 100% 0%,
        rgba(227, 120, 211, 0.4),
        transparent
      ),
      var(--text-primary);
    color: #fff;
    box-shadow:
      0 28px 60px rgba(17, 17, 17, 0.28),
      0 8px 18px rgba(17, 17, 17, 0.12);
      order: 2;
  }
  .fit-yes h3 {
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }
  .fit-yes li {
    color: rgba(255, 255, 255, 0.9);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .fit-yes li:last-child {
    border-bottom: 0;
  }
  .icon.yes {
    color: var(--accent-brand);
  }

  .fit-actions {
    margin-top: auto;
    padding-top: 32px;
  }
  .fit-cta {
    width: 100%;
    background: #fff;
    border-color: #fff;
    color: #111;
  }
  .fit-cta:hover {
    background: #ececf1;
    border-color: #ececf1;
    color: #111;
  }

  /* ---------- Tarjeta clara: "Quizás no es para vos si…" ---------- */
  .fit-no {
    background: var(--bg-primary);
    border: 1px solid var(--border);
    color: var(--text-primary);
  }
  .fit-no h3 {
    border-bottom: 1px solid var(--border);
  }
  .fit-no li {
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
  }
  .fit-no li:last-child {
    border-bottom: 0;
  }
  .icon.no {
    color: #8d8d96;
  }

  @media (max-width: 768px) {
    .fit-grid {
      grid-template-columns: 1fr;
    }
    .fit {
      padding: 28px;
    }
    .fit h3 {
      font-size: 22px;
    }
    .fit li {
      font-size: 16px;
    }
    .answer-text {
      font-size: 18px;
    }
    .fit-cta {
      width: 100%;
    }
  }
</style>
