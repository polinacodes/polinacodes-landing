---
import ShoppingCart from "@lucide/astro/icons/shopping-cart";
import Rocket from "@lucide/astro/icons/rocket";
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard";
import Wrench from "@lucide/astro/icons/wrench";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import type { Service, ServiceIcon } from "../data/services";

interface Props {
  service: Service;
}

const icons: Record<ServiceIcon, typeof ShoppingCart> = {
  cart: ShoppingCart,
  rocket: Rocket,
  dashboard: LayoutDashboard,
  wrench: Wrench,
};

const { service } = Astro.props;
const { slug, name, summary, bullets, hasPage } = service;
const Icon = icons[service.icon];
---

<article class="service-card">
  <div class="service-icon" aria-hidden="true">
    <Icon size={26} stroke-width={1.75} />
  </div>
  <h3>{name}</h3>
  <p>{summary}</p>
  <ul>
    {bullets.map((b) => <li>{b}</li>)}
  </ul>
  <div class="card-actions">
    <a class="btn btn-card" href="/#contacto" data-service={slug}
      >Pedir presupuesto <ArrowRight size={14} aria-hidden="true" /></a
    >
    {
      hasPage && (
        <a class="text-link" href={`/servicios/${slug}/`}>
          Ver detalle del servicio →
        </a>
      )
    }
  </div>
</article>

<style>
  .service-card {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 410px;
  padding: 25px;
  color: #fff;
  background:
    radial-gradient(circle 240px at 100% 0%, rgba(227, 120, 211, 0.28), transparent),
    var(--text-primary);
  border: 1px solid #2a2a2e;
  border-radius: var(--radius);
  transition:
    transform 0.3s var(--ease-out),
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}
.service-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-hover);
  border-color: rgba(227, 120, 211, 0.4);
}

.service-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(227, 120, 211, 0.16);
  color: var(--accent-brand);
  margin-bottom: 22px;
}

h3 {
  font-size: 18px;
  line-height: 1.25;
  letter-spacing: -0.02em;
  color: #fff;
  margin: 0 0 12px;
}
.service-card > p {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.78);
  margin: 0 0 18px;
}

ul {
  padding-left: 18px;
  margin: 0;
  color: rgba(255, 255, 255, 0.85);
  font-size: 12px;
}
li {
  margin-bottom: 8px;
}
li::marker {
  color: var(--accent-brand);
}

.card-actions {
  margin-top: auto;
  padding-top: 24px;
  text-align: center;
}
.btn-card {
  width: 100%;
  min-height: 43px;
  font-size: 12px;
  background: #fff;
  border-color: #fff;
  color: #111;
}
.btn-card:hover {
  background: #ececf1;
  border-color: #ececf1;
  color: #111;
}
.service-card .text-link {
  color: #fff;
}
.service-card .text-link:hover {
  color: var(--accent-brand);
}
</style>
