---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  /** Tarjeta horizontal, para cuando es el único proyecto de la sección */
  wide?: boolean;
}

const {
  title,
  description,
  technologies,
  url,
  image,
  imageAlt,
  imageStyle = "photo",
  caseStudy,
  mockup = "shop",
  metric,
} = Astro.props.project;
const { wide = false } = Astro.props;

const mockups = {
  shop: { label: "SHOP", headline: "Simple. Rápida.<br>Lista para vender." },
  agency: { label: "STUDIO", headline: "Tu marca.<br>En movimiento." },
  crm: { label: "CRM", headline: "Todo tu negocio<br>en un solo lugar." },
};
const m = mockups[mockup];
---

<article class:list={["project-card", { "is-wide": wide }]}>
  {
    image && imageStyle === "device" ? (
      <div class="mockup mockup-device">
        <Image
          src={image}
          alt={imageAlt ?? title}
          widths={[480, 720, 1040]}
          sizes={wide ? "(max-width: 768px) 85vw, 520px" : "(max-width: 768px) 85vw, 320px"}
        />
      </div>
    ) : image ? (
      <div class="mockup mockup-photo">
        <Image src={image} alt={imageAlt ?? title} width={640} />
      </div>
    ) : (
      <div class={`mockup ${mockup}`} aria-hidden="true">
        <div class="mock-browser">
          <>
            <b />
            <b />
            <b />
          </>
        </div>
        <div class="mock-content">
          <span>{m.label}</span>
          <strong set:html={m.headline} />
          {mockup === "shop" && (
            <>
              <i />
              <i />
            </>
          )}
          {mockup === "agency" && <div class="mock-pill" />}
          {mockup === "crm" && (
            <div class="dashboard">
              <i />
              <i />
              <i />
            </div>
          )}
        </div>
      </div>
    )
  }

  <div class="project-body">
  <div class="project-info">
    <div>
      <h3>{title}</h3>
      <p class="tech">{technologies.join(" · ")}</p>
    </div>
    {
      metric && (
        <strong class="score">
          {metric.value}
          <br />
          <small>{metric.label}</small>
        </strong>
      )
    }
  </div>
  <p class="description">{description}</p>
  <div class="project-links">
    {caseStudy && <a class="text-link" href={caseStudy}>Ver caso de estudio →</a>}
    {
      url && (
        <a class="text-link" href={url} target="_blank" rel="noopener noreferrer">
          Ver sitio en vivo →
        </a>
      )
    }
  </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px;
    background: var(--bg-primary);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: var(--shadow-hover);
  }

  .mockup {
    aspect-ratio: 16/9;
    background: #e7e7ea;
    border-radius: 12px;
    overflow: hidden;
    padding: 12px;
  }

  .mockup-photo {
    padding: 0;
  }
  .mockup-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mockup-device {
    position: relative;
    padding: 0;
    background:
      radial-gradient(circle at 80% 10%, rgba(240, 119, 175, 0.34), transparent 60%),
      var(--text-primary);
  }
  .mockup-device :global(img) {
    position: absolute;
    left: 7%;
    top: 50%;
    width: 86%;
    height: auto;
    display: block;
    transform: translateY(-50%);
    filter: drop-shadow(0 14px 18px rgba(0, 0, 0, 0.45));
  }

  .project-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .is-wide {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 16px;
    align-items: center;
  }
  .is-wide:hover {
    transform: translateY(-4px);
  }
  .is-wide .project-info h3 {
    font-size: 22px;
  }
  .is-wide .tech {
    font-size: 12px;
  }
  .is-wide .description {
    font-size: 15px;
    flex: none;
  }

  .mock-browser {
    height: 17px;
    display: flex;
    gap: 4px;
  }
  .mock-browser b {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #999;
  }

  .mock-content {
    height: calc(100% - 17px);
    border-radius: 8px;
    background: #fff;
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .mock-content span {
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: #777;
  }
  .mock-content strong {
    font-size: 25px;
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin-top: 10px;
    max-width: 240px;
  }
  .mock-content > i {
    display: block;
    width: 75%;
    height: 7px;
    background: #e5e5e5;
    border-radius: 3px;
    margin-top: 8px;
  }
  .mock-content > i:last-child {
    width: 50%;
  }

  .agency .mock-content {
    background: #151515;
    color: #fff;
  }
  .mock-pill {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: var(--accent-brand);
    position: absolute;
    right: 25px;
    bottom: 22px;
  }

  .crm .mock-content {
    background: #f3f3f5;
  }
  .dashboard {
    display: flex;
    gap: 7px;
    margin-top: 20px;
  }
  .dashboard i {
    width: 40px;
    height: 26px;
    background: #ddd;
    border-radius: 5px;
  }

  .project-info {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 20px 8px 4px;
  }
  h3 {
    font-size: 15px;
    margin: 0 0 5px;
  }
  .tech {
    font-size: 11px;
    color: #666;
    margin: 0;
  }

  .score {
    text-align: right;
    font-size: 16px;
    line-height: 1.1;
  }
  .score small {
    font-size: 8px;
    font-weight: 600;
    color: #666;
  }

  .description {
    flex: 1;
    font-size: 12px;
    color: var(--text-secondary);
    margin: 10px 8px 0;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px 18px;
    margin: 14px 8px 4px;
  }
  .is-wide .project-links {
    justify-content: flex-start;
  }

  @media (max-width: 768px) {
    .is-wide {
      grid-template-columns: 1fr;
    }
  }
</style>
